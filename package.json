{
  "name": "dshx-multi-ask",
  "version": "1.1.0",
  "private": true,
  "description": "Multi-model ask for DeepSeek Harness: send one question to several AI models at once and compare their streamed answers side by side in a right-sidebar panel (Ctrl+Shift+M or /multi).",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis"
  ],
  "author": "callaumyan-design",
  "license": "MIT",
  "homepage": "https://github.com/callaumyan-design/dshx-multi-ask#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/callaumyan-design/dshx-multi-ask.git"
  },
  "bugs": {
    "url": "https://github.com/callaumyan-design/dshx-multi-ask/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-context-menu"
      ]
    }
  }
}
